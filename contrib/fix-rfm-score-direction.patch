+def test_rfm_score_direction() -> None:
+    reference = pd.Timestamp("2026-06-30")
+    rows = [{"uid": "best", "date": reference - pd.Timedelta(days=d), "amount": 1000.0} for d in (1, 2, 3)]
+    rows += [{"uid": f"u{i}", "date": reference - pd.Timedelta(days=60 * i), "amount": 10.0 * i} for i in range(1, 5)]
+    result = op_rfm(pd.DataFrame(rows), {
+        "id_field": "uid", "date_field": "date", "value_field": "amount",
+        "bins": 5, "reference_date": "2026-06-30", "min_segment_size": 1,
+    })
+    best = [item for item in result["segments"] if item["median_monetary"] == 3000.0]
+    check("rfm 最近、最频繁、金额最高的实体落在 high_value_active",
+          len(best) == 1 and best[0]["segment"] == "high_value_active",
+          f"segments={[(item['segment'], item['median_monetary']) for item in result['segments']]}")
+
+
